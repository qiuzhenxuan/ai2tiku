# The browser-visible address, without a trailing slash. Use HTTPS in production.
PUBLIC_URL=http://localhost:8080
ADMIN_EMAIL=admin@example.com
# Closed registration: the administrator creates accounts in the console.
REGISTRATION_OPEN=false
# Optional administrator-approved HTTPS OpenAI-compatible API bases, comma separated.
# Tenants can only choose these and the built-in providers; they cannot submit arbitrary URLs.
ALLOWED_PROVIDER_URLS=
# Default: expose only to a reverse proxy running on this server.
LISTEN_ADDRESS=127.0.0.1
HTTP_PORT=8080
